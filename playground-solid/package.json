{
  "name": "markstream-solid-playground",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --port 4177",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4177",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "hydration:generate": "node scripts/generate-hydration.mjs"
  },
  "dependencies": {
    "@antv/infographic": "^0.2.19",
    "@terrastruct/d2": ">=0.1.33",
    "katex": "^0.16.47",
    "markstream-solid": "workspace:*",
    "mermaid": ">=11.16.0",
    "solid-js": "^1.9.15",
    "stream-diffs": "latest",
    "stream-markdown-parser": "workspace:*"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.24",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^3.2.4"
  }
}
